{
  "name": "hrlens-playwright-ts",
  "version": "1.0.0",
  "description": "3-Tier Playwright + TypeScript Test Automation Framework with Google Sheets Integration, API Testing, Docker, and GitHub Actions",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium-ui",
    "test:api": "playwright test --project=api-tests",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report reports/html-report",
    "docker:build": "docker build -t hrlens-playwright -f docker/Dockerfile .",
    "docker:run": "docker-compose -f docker/docker-compose.yml up --exit-code-from playwright-tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "api-testing",
    "google-sheets",
    "docker",
    "github-actions"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.6.0",
    "google-spreadsheet": "^4.1.2",
    "googleapis": "^181.0.0",
    "winston": "^3.11.0"
  }
}
